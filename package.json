{
  "name": "shieldcortex-sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for the ShieldCortex API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "shieldcortex",
    "ai",
    "security",
    "memory",
    "firewall"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drakon-Systems-Ltd/shieldcortex-sdk.git"
  }
}
